# Agronia AI service - contoh konfigurasi environment.
# Salin file ini menjadi `ai/.env` lalu sesuaikan nilainya.
# File `.env` yang asli tidak boleh di-commit (sudah masuk `.gitignore`).

# Lokasi berkas bobot model, relatif terhadap folder `ai/` atau absolut.
# Berkas bobot tidak di-commit; salin hasil training ke `ai/weights/`.
AI_MODEL_PATH=weights/agronia_rice_mobilenetv2.keras
# Ukuran input model dalam piksel. Wajib konsisten dengan proses training.
AI_IMAGE_SIZE=224
