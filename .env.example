# Agronia backend - contoh konfigurasi environment.
# Salin file ini menjadi `.env` di folder `ai-model/` lalu sesuaikan nilainya.
# File `.env` yang asli tidak boleh di-commit (sudah masuk .gitignore).

# --- Django ---
# WAJIB diisi di production. Di development boleh dikosongkan (ada fallback dev).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Kosongkan untuk memakai SQLite (default development).
DJANGO_DATABASE_URL=

# --- Media / upload ---
# Batas ukuran file unggahan dalam megabyte.
DJANGO_MAX_UPLOAD_SIZE_MB=10

# --- AI service ---
# Lokasi file bobot model (.pt / .onnx). Kosongkan sampai model benar-benar tersedia.
AI_MODEL_PATH=
# Ambang confidence (0.0 - 1.0). Di bawah nilai ini hasil dianggap tidak meyakinkan.
AI_CONFIDENCE_THRESHOLD=0.60
