# Agronia backend - contoh konfigurasi environment.
# Salin file ini menjadi `backend/.env` lalu sesuaikan nilainya.
# File `.env` yang asli tidak boleh di-commit (sudah masuk `.gitignore`).

# --- Django ---
# WAJIB diisi di production. Di development boleh dikosongkan (ada fallback dev).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database ---
# Kosongkan untuk memakai SQLite (default development).
DJANGO_DATABASE_URL=

# --- Media / upload ---
# Batas ukuran file unggahan dalam megabyte.
DJANGO_MAX_UPLOAD_SIZE_MB=10

# --- AI service ---
# Alamat layanan inferensi FastAPI di folder `ai/`.
AI_SERVICE_URL=http://localhost:8001
# Batas waktu permintaan inferensi dalam detik.
AI_SERVICE_TIMEOUT=30
# Ambang confidence (0.0 - 1.0) untuk menandai hasil sebagai meyakinkan.
AI_CONFIDENCE_THRESHOLD=0.60
